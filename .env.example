# PostgreSQL connection string
DATABASE_URL="postgresql://postgres@localhost:5434/nexora?schema=public"

# Minimum 32 characters. Used to encrypt the session cookie.
SESSION_PASSWORD="replace-with-a-long-random-string-at-least-32-chars"

# Public app metadata
NEXT_PUBLIC_APP_NAME="NEXORA"

# Enables the demo role switcher on the login screen
NEXORA_DEMO_MODE="true"
