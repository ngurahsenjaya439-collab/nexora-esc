# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Opsi A — PostgreSQL lokal (default proyek, cluster dev port 5434)
DATABASE_URL="postgresql://postgres@localhost:5434/nexora?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5434/nexora?schema=public"

# Opsi B — Neon (production). Ganti dua baris di atas dengan:
#   DATABASE_URL = pooled connection (host mengandung "-pooler") → dipakai runtime
#   DIRECT_URL   = direct connection (tanpa "-pooler")            → dipakai migrasi
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Minimum 32 characters. Used to encrypt the session cookie.
# Wajib diisi saat build/deploy production (aplikasi menolak start bila kosong).
SESSION_PASSWORD="replace-with-a-long-random-string-at-least-32-chars"

# Public app metadata
NEXT_PUBLIC_APP_NAME="NEXORA"

# Enables the demo role switcher on the login screen
NEXORA_DEMO_MODE="true"
